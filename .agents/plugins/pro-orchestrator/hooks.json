{
  "pro-orchestrator-guard": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ./scripts/orchestrator_guard.py pre-invocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/orchestrator_guard.py pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "invoke_subagent|manage_subagents",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/orchestrator_guard.py post-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/orchestrator_guard.py stop",
        "timeout": 5
      }
    ]
  }
}
